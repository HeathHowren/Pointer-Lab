#include <windows.h>
#include "Version.h"

// Application icon (first icon = the one Explorer shows).
1 ICON "PointerLab.ico"

// Application manifest (RT_MANIFEST = 24). CREATEPROCESS_MANIFEST_RESOURCE_ID = 1.
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    POINTERLAB_RC_VERSION
 PRODUCTVERSION POINTERLAB_RC_VERSION
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      POINTERLAB_COMPANY_NAME
            VALUE "FileDescription",  "Pointer Lab - Windows memory research tool"
            VALUE "FileVersion",      POINTERLAB_VERSION_STRING
            VALUE "InternalName",     "PointerLab"
            VALUE "LegalCopyright",   POINTERLAB_COPYRIGHT
            VALUE "OriginalFilename", "PointerLab.exe"
            VALUE "ProductName",      POINTERLAB_PRODUCT_NAME
            VALUE "ProductVersion",   POINTERLAB_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
